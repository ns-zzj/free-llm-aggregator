# ============================================================================
# 部署级配置 —— 完整清单，一共就这 5 项。
#
# 优先级：**环境变量 > 这个文件 > 程序内置默认值**
#
# ⚠ 这个文件在 Docker 下**不参与**：镜像没把它打进去、compose 也没挂它。所以容器里的实际链路是
#   「环境变量 → 内置默认」。要用 Docker 就改 docker-compose.yml 的 environment: 段。
#   这个文件只在**不用 Docker**（npm start 直接跑）时才生效 —— 那时才是完整的三层。
#
# 某一层给了值但**值不合法** → 当作"这一层没配"，继续往下一层找。
# 例：环境变量 PORT=abc → 不认 → 用这个文件里的 9000 → 这个文件也没有 → 用内置默认 8787。
# （例外：BIND 和 APP_SECRET 写错了**直接启动失败**，不兜。）
#
# 启动日志开头会打一张表，逐项说明每个值用的是哪一层、认没认、不认谁、最后用了什么。
# ============================================================================

# 监听端口。容器里默认 8787（来自 Dockerfile 的 ENV），compose 用 PORT 覆盖它。
PORT=8787

# 额外信任的"管理端来源"（反代 / Docker 网桥的地址）。**一般留空**。
# 格式：逗号分隔；单个 IP 或 IPv4 网段（如 10.0.2.0/24）；IPv6 只支持写完整地址、不支持网段。
# 什么时候需要：用 Docker bridge 发布端口、rootless Docker（slirp4netns）、或反代装在**别的**
# 机器上 —— 那些情况真实客户端 IP 会被抹成网关地址，管理端闸默认**拒绝**（fail-closed），
# 把那个地址写在这儿才放行。
# ⚠ 来自这些地址的请求会**一律放行**后台；而且带了 X-Forwarded-For 的请求，头里的地址命中
#   名单也会放行 —— 但那个头客户端可以伪造，所以前提是"外面绕不过你的代理、没法直连本服务"。
ADMIN_TRUSTED_PEERS=

# 后台能不能从公网直接访问。**只认 true / false**（大小写不敏感），写别的等于没写。
#   false（默认）= 不允许：后台只收本机/内网直连，公网打开 /admin 会 403（这是设计）
#   true         = 允许公网直接管后台。⚠ 前提是前面**有 TLS**（反代 / Cloudflare Tunnel），
#                  否则管理口令和会话 cookie 会明文过网，等于没设防
#   留空 / 不写 / 写错 = 同 false（用内置默认，最安全那一档）
# 这是**唯一**能放开后台的开关：后台「设置」页里没有对应的选项，改这个变量要重启。
ALLOW_PUBLIC_INTERNET=false


# ---------------------------------------------------------------------------
# 下面两项：**compose 默认不传**，网页设置里也没有。用 Docker 又要改的话，
# 自己在 compose 的 environment: 段里加一行，例如：
#
#     LOG_LEVEL: "debug"
#     SESSION_TTL_MS: "3600000"
# ---------------------------------------------------------------------------

# 日志级别：debug | info | warn | error。默认 info。
# 注意：调成 warn / error 会把启动时那张「配置来源表」一起静音。
LOG_LEVEL=info

# 后台会话有效期（毫秒）。默认 12 小时。
SESSION_TTL_MS=43200000
